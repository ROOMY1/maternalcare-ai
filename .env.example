# MaternalCare AI settings. Copy to .env (never upload .env).
# Fully local: no API keys are needed anywhere in this project.
OLLAMA_BASE_URL=http://127.0.0.1:11434   # not localhost: avoids a ~2 s IPv6 fallback per connection on Windows
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m
LLM_NUM_PREDICT=512                    # max tokens per answer (stops runaway output)
LLM_REPEAT_PENALTY=1.1
REWRITE_NUM_PREDICT=48                 # max tokens for the Arabic-to-English search query
JUDGE_MODEL=qwen2.5:7b-instruct        # Ragas judge (bigger is better if the laptop allows)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto                      # auto|cuda|mps|cpu
EMBED_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K=4
SIMILARITY_THRESHOLD=0.57               # re-calibrated with the Arabic English-query step (eval/retrieval_eval.py --calibrate --translate)
COLLECTION_NAME=maternal_guidelines
HF_HUB_OFFLINE=0                       # set to 1 after the first model download
ENABLE_HYBRID=false                    # optional extension (M8)
ENABLE_RERANKER=false                  # optional extension (M8)
